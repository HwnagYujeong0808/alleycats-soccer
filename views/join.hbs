{{!-- Join the Cats page --}}
{{!-- Add this stylesheet in the page layout/head: --}}
<link rel="stylesheet" href="/css/join.css" />
<link rel="stylesheet" href="/css/style.css" />

<section class="site-hero">
  <div class="site-hero__inner">
    <h1>Join the Cats</h1>
  </div>
</section>

<section class="join-register">
  <div class="join-container join-narrow">
    <h2 class="join-section-title">How to Register as Player?</h2>

    <div class="join-steps" aria-label="Registration steps">
      <div class="join-step is-active">
        <span class="join-step-label">Create or Log Into<br>Your PlayMetrics Account</span>
        <span class="join-step-dot"></span>
      </div>
      <div class="join-step">
        <span class="join-step-label">Add Your Player</span>
        <span class="join-step-dot"></span>
      </div>
      <div class="join-step">
        <span class="join-step-label">Register for<br>Available Programs</span>
        <span class="join-step-dot"></span>
      </div>
    </div>

    <div class="join-step-cards">
      <article class="join-step-card join-portal-card">
        <div class="join-card-logo">
          <img src="/images/home/ALLEYCATS.png" alt="Alleycats logo" loading="lazy" />
        </div>
        <h3>PlayMetrics Portal</h3>
        <p>All Alleycats registrations are managed through the PlayMetrics platform.</p>
        <a class="join-red-btn" href="https://playmetrics.com/signup?clubToken=TG9naW4tQ2x1Yi52MS0zNjMtMTc4NDk5NTg4OHxCeVJsQk1WR1V0VHpGampwbm9QMGY3cGVoV3NoNWpoZVpmbCtmVVVTUmJnPQ==&program_id=101343" target="_blank" rel="noopener">Register Now</a>
      </article>

      <article class="join-step-card">
        <div class="join-screenshot">
          <img src="/images/join/add-player.png" alt="Add player form in PlayMetrics" loading="lazy" />
        </div>
        <p>After logging in, select “Add Players” and enter the player’s information.</p>
      </article>

      <article class="join-step-card">
        <div class="join-screenshot">
          <img src="/images/join/club-programs.png" alt="Club programs page in PlayMetrics" loading="lazy" />
        </div>
        <p>Once your player has been added, navigate to the Club Programs section to view all available programs and registrations.</p>
      </article>
    </div>
  </div>
</section>

<section class="join-program-list">
  <div class="join-container join-list-width">
    <h2 class="join-section-title">Our Programs</h2>

    <div class="program-list">
      <article class="program-list-card">
        <div class="program-list-logo">
          <img src="/images/home/ALLEYCATS.png" alt="" loading="lazy" />
        </div>
        <div class="program-list-text">
          <h3>Alleycats 2026-27 Tryouts</h3>
          <p>Albany Alleycats 2026-2027 Tryout Player Registration</p>
        </div>
        <span class="program-tag">Tryout</span>
      </article>

      <article class="program-list-card">
        <div class="program-list-logo">
          <img src="/images/home/ALLEYCATS.png" alt="" loading="lazy" />
        </div>
        <div class="program-list-text">
          <h3>Alleycats Summer 2026 Interested Players</h3>
          <p>Interested player form for placement in the Alleycats 2026 Summer program. This includes UPSL Women's team programming, as well as all summer program training, Afrim's summer league play, and other miscellaneous events that will be added into the summer program.</p>
        </div>
        <span class="program-tag">Tryout</span>
      </article>

      <article class="program-list-card">
        <div class="program-list-logo">
          <img src="/images/home/ALLEYCATS.png" alt="" loading="lazy" />
        </div>
        <div class="program-list-text">
          <h3>970 United 2026-27 Tryouts</h3>
          <p>970 United 2026-2027 Tryout Player Registration</p>
        </div>
        <span class="program-tag">Tryout</span>
      </article>
    </div>
  </div>
</section>

<section id="programs" class="programs join-programs">
  <div class="programs-header fade-up">
    <h2 class="join-section-title">Teams / Programs</h2>
    <p class="join-programs-subtitle">At Alleycats Soccer Club, we develop players at every level through quality coaching, real competition, and a culture of excellence and sportsmanship. 2025–26 season tryouts are coming soon (expected mid-June).</p>
  </div>

  <div class="programs-grid">
    <div class="program-card fade-up">
      <img src="/images/home/Teams1.png" alt="Joining the Alleycats" loading="lazy" />
      <div class="program-card-overlay">
        <h3>Interested in joining the Alleycats</h3>
        <span class="btn-card btn--disabled">Prospective Player Form</span>
      </div>
    </div>

    <div class="program-card fade-up" style="transition-delay:.1s">
      <img src="/images/home/Teams2.png" alt="Register a Player" loading="lazy" />
      <div class="program-card-overlay">
        <h3>Register a Player (Required Guardian’s Information)</h3>
        <a href="https://playmetrics.com/signup?clubToken=TG9naW4tQ2x1Yi52MS0zNjMtMTc4NDk5NTg4OHxCeVJsQk1WR1V0VHpGampwbm9QMGY3cGVoV3NoNWpoZVpmbCtmVVVTUmJnPQ==&program_id=101343" target="_blank" rel="noopener" class="btn-card">Register Now</a>
      </div>
    </div>
  </div>
</section>
